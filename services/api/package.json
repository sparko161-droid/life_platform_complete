{
  "name": "@life/services-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "echo TODO",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test ./test/*.test.ts",
