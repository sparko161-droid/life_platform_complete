#!/bin/sh
# Refuses a direct push to main. AGENTS.md: "Never: merge directly into main".
#
# This is a *client-side* guard, deliberately: the repo is private on a plan
# where GitHub's own branch protection is unavailable, so this is the only
# enforcement point that exists today. It is not a security control -- anyone
# can bypass it with --no-verify. It exists to stop the accident, not an
# attacker. Once server-side branch protection is enabled
# (docs/engineering/branch-protection.md), that becomes the real gate and this
# hook stays as a faster local signal.
#
# Enable once per clone:
#   git config core.hooksPath .githooks

protected="main"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    "refs/heads/$protected")
      echo "pre-push: refusing to push directly to '$protected'." >&2
      echo "" >&2
      echo "  Open a PR from a feature branch instead:" >&2
      echo "    git switch -c agent/<role>/<task-id>-<slug>" >&2
      echo "    git push -u origin HEAD" >&2
      echo "" >&2
      echo "  See docs/engineering/git-workflow.md. If you genuinely need to" >&2
      echo "  bypass this (e.g. applying branch protection itself), re-run" >&2
      echo "  with --no-verify and say so in the commit message." >&2
      exit 1
      ;;
  esac
done

exit 0
