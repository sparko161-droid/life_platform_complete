{
  "name": "@life/ui-language",
  "private": true,
  "version": "0.1.0",
  "description": "Russian-only UI localization lint and forbidden-term checks (P1-012). Machine-checkable counterpart to docs/ux/ui-language.md.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ui-language-lint": "./dist/cli.js"
  },
  "scripts": {
    "lint": "node --import tsx ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test ./test/*.test.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
