{
  "name": "life-platform",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "build": "pnpm -r --if-present run build",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:infra:health": "node scripts/health-check.mjs",
    "db:migrate:up": "pnpm --filter @life/services-api run migrate:up",
    "db:migrate:down": "pnpm --filter @life/services-api run migrate:down",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "dev:seed": "pnpm db:migrate:up && pnpm --filter @life/fixtures run build && pnpm --filter @life/fixtures run seed",
    "format": "pnpm exec prettier . --write",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "task-registry": "pnpm --filter @life/tools-task-registry run dev",
    "contracts:validate": "pnpm --filter @life/tools-task-registry run dev -- contracts validate",
    "docs:check": "node scripts/check-docs-graph.mjs",
    "dashboard": "node scripts/dashboard-server.mjs",
    "quality:dead-code": "knip"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.3.1",
    "knip": "^5.63.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
