# Copy to .env and fill in real values for local dev, or better: run
# `doppler setup && doppler run -- <command>` so nothing lands on disk in
# plaintext (see docs/security/secrets-policy.md). Names only here, never
# real values -- this file is committed.

NODE_ENV=development
LOG_LEVEL=info

# Matches docker-compose.dev.yml (P0-002). Host port defaults to 5433, not
# 5432, because 5432 is commonly already taken by another local project;
# see the comment in docker-compose.dev.yml for why.
DATABASE_URL=postgres://life:life_dev@localhost:5433/life
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev

# Optional. Unset in local dev -- packages/observability (P0-007) no-ops
# cleanly without these rather than requiring them.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# CI only (set as a GitHub Actions Encrypted Secret, not here). Bootstraps
# Doppler itself to fetch everything else -- see docs/security/secrets-policy.md.
DOPPLER_TOKEN=
